{
  "name": "tripwise-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run pendo:build-id && vite",
    "build": "npm run pendo:build-id && tsc -b && vite build && npm run pendo:register",
    "preview": "vite preview",
    "pendo:build-id": "pendo build create --manifest=.pendo-build/manifest.json --output=src/pendo-build.js",
    "pendo:register": "pendo build register --manifest=.pendo-build/manifest.json --apiKey=f59ab641-f8df-445a-b7bf-ec86b369dd89 --env=io --endpoint=https://data.pendo-dev.pendo-dev.com"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@pendo/web-sdk": "^2.352.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
